<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔧 高级设置"
            android:textSize="22sp"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- LLM 大模型设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 大模型 API 设置"
            android:textSize="16sp"
            android:textColor="#6D4C41"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- API 地址 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API 地址"
                    android:textSize="13sp"
                    android:textColor="#6D4C41"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_api_url"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="https://api.deepseek.com/chat/completions"
                    android:textSize="13sp"
                    android:inputType="textUri"
                    android:padding="10dp"
                    android:background="@android:drawable/editbox_background"
                    android:layout_marginBottom="12dp" />

                <!-- API Key -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API Key"
                    android:textSize="13sp"
                    android:textColor="#6D4C41"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="sk-xxxxxxxxxxxx"
                    android:textSize="13sp"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:background="@android:drawable/editbox_background"
                    android:layout_marginBottom="12dp" />

                <!-- 模型名称 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="模型名称"
                    android:textSize="13sp"
                    android:textColor="#6D4C41"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_model"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="deepseek-chat"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:padding="10dp"
                    android:background="@android:drawable/editbox_background"
                    android:layout_marginBottom="12dp" />

                <!-- 保存按钮 -->
                <Button
                    android:id="@+id/btn_save_llm"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="💾 保存大模型配置"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_btn_primary" />

                <!-- 测试连接 -->
                <Button
                    android:id="@+id/btn_test_llm"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔌 测试 API 连接"
                    android:textSize="14sp"
                    android:textColor="#6D4C41"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 话术库设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 话术库同步"
            android:textSize="16sp"
            android:textColor="#6D4C41"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前版本: "
                        android:textSize="13sp"
                        android:textColor="#998675" />

                    <TextView
                        android:id="@+id/tv_script_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v0（本地）"
                        android:textSize="13sp"
                        android:textColor="#3E2723"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上次同步: "
                        android:textSize="13sp"
                        android:textColor="#998675" />

                    <TextView
                        android:id="@+id/tv_last_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="从未同步"
                        android:textSize="13sp"
                        android:textColor="#3E2723" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_sync_now"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔄 立即同步话术库"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_btn_primary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 底部说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 提示：\n• 大模型 API 用于实时生成个性化的佛法回复\n• 支持任何兼容 OpenAI API 的模型（DeepSeek、智谱、Qwen等）\n• 话术库支持远程更新，无需更新应用即可获取最新话术\n• 网络不可用时自动使用本地话术库兜底"
            android:textSize="12sp"
            android:textColor="#BCAAA4"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
